# URL du backend FastAPI (jamais exposée au navigateur)
BACKEND_URL=http://localhost:8000
# Jeton identique à ADMIN_API_TOKEN du backend
BACKEND_ADMIN_TOKEN=change-moi
# Mot de passe de l'espace administrateur
ADMIN_PASSWORD=change-moi
# Secret de signature des sessions (32+ caractères aléatoires)
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire
