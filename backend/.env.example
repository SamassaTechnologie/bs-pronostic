# --- Base de données -------------------------------------------------------
# Supabase : Project Settings > Database > Connection string > « Session pooler » (URI)
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# En local, laissez vide pour utiliser SQLite : sqlite:///./sam_prediction.db

# --- Sécurité ----------------------------------------------------------------
ADMIN_API_TOKEN=une-longue-chaine-aleatoire   # partagée avec le frontend (BACKEND_ADMIN_TOKEN)
CRON_SECRET=une-autre-chaine-aleatoire        # pour le déclenchement planifié externe
CORS_ORIGINS=https://votre-site.vercel.app

# --- Fournisseurs de données -----------------------------------------------
FOOTBALL_DATA_CO_UK_ENABLED=true              # gratuit, sans clé
API_FOOTBALL_KEY=                             # optionnel : absences, cotes multi-marchés, ligues africaines
API_FOOTBALL_DAILY_BUDGET=90                  # plan gratuit : 100 requêtes/jour
FOOTBALL_DATA_ORG_KEY=                        # optionnel : Ligue des champions, etc.

# --- Planification ---------------------------------------------------------
ENABLE_SCHEDULER=true
SYNC_INTERVAL_MINUTES=180
HISTORY_SEASONS=3
DEFAULT_TIMEZONE=Africa/Bamako
